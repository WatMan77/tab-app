# Copy to .env.production. Replace every CHANGE_ME.
# The password inside POSTGRES_URL has to match POSTGRES_PASSWORD.

# --- Database (read by the backend and by Docker Compose) ---
POSTGRES_USER=postgres
POSTGRES_DB=tab_db
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=db
POSTGRES_URL=postgres://postgres:CHANGE_ME@db:5432/tab_db

# --- Backend ---
SECRET=CHANGE_ME
REDIS_URL=redis://redis:6379

# --- Frontend. Vite only exposes names starting with VITE_ ---
# VITE_API_URL=http://localhost:3000   # optional, defaults to http://localhost:3000

# --- Backup and restore scripts only ---
DB_CONTAINER="<project>-db-1"
REDIS_CONTAINER="<project>-redis-1"
DESTINATION_URL=CHANGE_ME   # user@host of the backup server
SSHPASS=CHANGE_ME
DESTINATION_DIR=/path/to/db_backups
