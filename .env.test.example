# Copy to .env.test. The test suites truncate this database.
# The password inside POSTGRES_URL has to match POSTGRES_PASSWORD.

# --- Database (read by the backend and by Docker Compose) ---
POSTGRES_USER=postgres
POSTGRES_DB=test-db
POSTGRES_PASSWORD=test
POSTGRES_HOST=localhost
POSTGRES_URL=postgres://postgres:test@localhost:5432/test-db

# --- Backend ---
SECRET=secret
REDIS_URL=redis://localhost:6379

# --- Frontend. Vite only exposes names starting with VITE_ ---
VITE_API_URL=http://localhost:3000

# --- Backup and restore scripts only ---
DB_CONTAINER="<project>-test-db-1"
REDIS_CONTAINER="<project>-redis-1"
